{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "dev:training": "wrangler pages dev dist-training --d1=webapp-production --local --ip 0.0.0.0 --port 3002",
    "build": "vite build",
    "build:customer": "vite build --config vite.config.customer.ts",
    "build:training": "vite build --config vite.config.training.ts",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name webapp",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-production",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "clean-port:customer": "fuser -k 3001/tcp 2>/dev/null || true",
    "clean-port:training": "fuser -k 3002/tcp 2>/dev/null || true",
    "git:commit": "git add . && git commit -m"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "hono": "^4.10.1"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
